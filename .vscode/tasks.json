{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build app bundle",
      "type": "shell",
      "command": "./Scripts/build-debug.sh",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$swiftc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build (debug, fast)",
      "type": "shell",
      "command": "CONFIG=debug ./Scripts/build-debug.sh",
      "group": "build",
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Run app",
      "type": "shell",
      "command": "open build/Meeting.app",
      "dependsOn": "Build app bundle",
      "problemMatcher": []
    },
    {
      "label": "Stop app",
      "type": "shell",
      "command": "pkill -f 'Meeting.app/Contents/MacOS/Meeting' || true",
      "problemMatcher": []
    },
    {
      "label": "Rebuild and restart",
      "type": "shell",
      "command": "./Scripts/build-debug.sh --run",
      "group": "build",
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Tail app logs",
      "type": "shell",
      "command": "log stream --predicate 'process == \"Meeting\"' --level debug",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
